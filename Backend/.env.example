# Copy this file to `.env` (or set these environment variables) to enable
# real AI providers in the Study Planner AI Learning Hub.
#
# The AI Hub works out of the box in "demo mode" with a built-in mock provider.
# Set ONE of the API keys below to activate a real model:
#
#   - OPENAI_API_KEY        -> GPT models
#   - ANTHROPIC_API_KEY     -> Claude models
#   - GOOGLE_AI_API_KEY     -> Gemini models
#
# If no key is set, the hub runs in mock mode and clearly marks replies as demos.

# Flask session secret. Override with a long random string in production.
SECRET_KEY=study-planner-dev-secret

# SQLite database file. Defaults to Database/instance/study_planner.db
#DATABASE_PATH=Database/instance/study_planner.db

# --- Google sign-in ----------------------------------------------------------
# Set BOTH to enable "Continue with Google" for everyone. In production define
# these on your host (Render Dashboard -> Environment) instead of in-app.
# Register https://<your-app>.onrender.com/oauth/google/callback as an
# Authorized redirect URI on the Web-application OAuth client.
#GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Production database (Neon/Postgres) ----------------------------------------------
# Set DATABASE_URL to a PostgreSQL connection string (e.g. from Neon) and the app
# switches from local SQLite to Postgres. All tables, planner data, and sessions
# live in Postgres, so the app is ready for a stateless host like Render.
# Leave unset for local development (SQLite).
#DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional: OpenAI -----------------------------------------------------------------
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional: Anthropic --------------------------------------------------------------
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Optional: Google Gemini ----------------------------------------------------------
#GOOGLE_AI_API_KEY=
#GOOGLE_AI_MODEL=gemini-2.0-flash
#GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Limits (optional overrides) ------------------------------------------------------
#AI_MAX_REQUESTS_PER_DAY=100
#AI_MAX_QUESTION_CHARS=8000
#AI_MAX_MATERIAL_CHARS=60000
#AI_MAX_OUTPUT_TOKENS=2000
#AI_MAX_FILE_BYTES=10485760