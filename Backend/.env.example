# Copy this file to `.env` (or set these environment variables) to enable
# real AI providers in the Study Planner AI Learning Hub.
#
# The AI Hub works out of the box in "demo mode" with a built-in mock provider.
# Set ONE of the API keys below to activate a real model:
#
#   - OPENAI_API_KEY        -> GPT models
#   - ANTHROPIC_API_KEY     -> Claude models
#   - GOOGLE_AI_API_KEY     -> Gemini models (GEMINI_API_KEY is accepted too)
#   - DEEPSEEK_API_KEY      -> DeepSeek models
#   - COPILOT_GITHUB_TOKEN  -> Copilot "o1" models (GH_TOKEN is accepted too)
#
# If no key is set, the hub runs in mock mode and clearly marks replies as demos.

# Flask session secret. Override with a long random string in production.
SECRET_KEY=study-planner-dev-secret

# SQLite database file. Defaults to Database/instance/study_planner.db
#DATABASE_PATH=Database/instance/study_planner.db

# --- Google sign-in ----------------------------------------------------------
# Set BOTH to enable "Continue with Google" for everyone. In production define
# these on your host (Render Dashboard -> Environment) instead of in-app.
# Register https://<your-app>.onrender.com/oauth/google/callback as an
# Authorized redirect URI on the Web-application OAuth client.
#GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# --- Production database (Neon/Postgres) ----------------------------------------------
# Set DATABASE_URL to a PostgreSQL connection string (e.g. from Neon) and the app
# switches from local SQLite to Postgres. All tables, planner data, and sessions
# live in Postgres, so the app is ready for a stateless host like Render.
# Leave unset for local development (SQLite).
#DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional: OpenAI -----------------------------------------------------------------
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional: Anthropic --------------------------------------------------------------
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-3-5-sonnet-latest
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Optional: Google Gemini ----------------------------------------------------------
#GOOGLE_AI_API_KEY=
#GOOGLE_AI_MODEL=gemini-2.0-flash
#GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Limits (optional overrides) ------------------------------------------------------
#AI_MAX_REQUESTS_PER_DAY=100
#AI_MAX_QUESTION_CHARS=8000
#AI_MAX_MATERIAL_CHARS=60000
#AI_MAX_OUTPUT_TOKENS=2000
#AI_MAX_FILE_BYTES=10485760

# --- Stash (PDF/PPTX -> AI idea cards) ------------------------------------------------
# Stash uploads PDFs and PowerPoints, then generates Deepstash-style idea cards.
# It never uses the mock provider: it needs a real AI key, either one of the server-side
# keys above (checked in this order: Anthropic, OpenAI, Gemini, DeepSeek, Copilot) or each
# user's own key from Settings -> AI Settings, unless the privacy toggle "AI activity" is off.
#
# Which provider/model Stash prefers by default when the user hasn't picked one explicitly.
#STASH_PROVIDER=anthropic
#
# Upload limits.
#STASH_MAX_FILE_BYTES=52428800
#STASH_MAX_PDF_PAGES=600
#STASH_MAX_PPTX_SLIDES=200
#
# Generation.
#STASH_MODEL=claude
#STASH_MAX_OUTPUT_TOKENS=3000
#STASH_TEMPERATURE=0.2
# Per-user daily AI token cap (soft limit; exceeded uploads queue until tomorrow).
#STASH_DAILY_TOKEN_CAP=250000
#
# Chunking.
#STASH_CHUNK_TARGET_CHARS=1700
#STASH_CHUNK_MAX_CHARS=2200
#
# Background worker.
#STASH_WORKER_POLL_SECONDS=3
#STASH_REAP_AFTER_SECONDS=300
#STASH_HEARTBEAT_SECONDS=30
#STASH_JOB_MAX_ATTEMPTS=3
#STASH_DISABLE_WORKER=1
#
# Optional on-disk backup of uploaded source files (defaults to storing them;
# set "0" to disable). Uploaded bytes are always processed; text lives in the DB.
#STASH_UPLOAD_DIR=Database/stash_uploads
#STASH_KEEP_SOURCE_FILES=1

# --- AI Gateway -----------------------------------------------------------------------
# The gateway is the single server-side boundary for AI access: it owns
# provider/model selection, key resolution (server keys then the student's own
# BYOK), usage accounting, quotas, caching, fallback and circuit-breaking. It
# reuses the provider keys listed at the top of this file (OPENAI_API_KEY,
# ANTHROPIC_API_KEY, GOOGLE_AI_API_KEY/GEMINI_API_KEY, DEEPSEEK_API_KEY,
# COPILOT_GITHUB_TOKEN/GH_TOKEN, plus GROQ/MISTRAL/OPENROUTER/CEREBRAS if set).

# Admin console allow-list: comma-separated account emails permitted to open
# /admin/ai-gateway and the /api/ai-gateway/admin/* endpoints. Empty (the
# default) disables the whole admin surface — it fails closed.
#AI_GATEWAY_ADMIN_EMAILS=you@example.com,teammate@example.com

# Per-user daily request quotas by model tier (server-funded requests only).
#AI_GATEWAY_FREE_DAILY_REQUESTS=40
#AI_GATEWAY_STANDARD_DAILY_REQUESTS=60
#AI_GATEWAY_PREMIUM_DAILY_REQUESTS=80

# Shared-content response cache for document generation (never personal text).
#AI_GATEWAY_CACHE_ENABLED=1
#AI_GATEWAY_CACHE_MAX_ROWS=500
#AI_GATEWAY_CACHE_TTL_SECONDS=86400

# Fallback + circuit breaker.
#AI_GATEWAY_FALLBACK_MAX_TRIES=3
#AI_GATEWAY_CIRCUIT_THRESHOLD=3
#AI_GATEWAY_CIRCUIT_OPEN_SECONDS=300

# Provider call timeout (seconds).
#AI_GATEWAY_TIMEOUT_SECONDS=60

# --- Uploaded files ---------------------------------------------------------------------
# Profile photos, course materials, Stash source documents and AI Hub material
# text are stored through Backend/storage.py. The default backend ("database")
# keeps the bytes in the file_blobs table, so a file uploaded on one phone is
# there on your laptop and survives a redeploy — required on hosts with an
# ephemeral disk such as Render.
#
# Set FILE_STORAGE_BACKEND=local to write them under FILE_STORAGE_DIR instead.
# That is convenient on a laptop but loses everything on each deploy, so do not
# use it in production.
#FILE_STORAGE_BACKEND=database
#FILE_STORAGE_DIR=Database/uploads

# Note: STASH_UPLOAD_DIR above only affects the local backend. The "database"
# backend ignores it, which is what you want on Render.